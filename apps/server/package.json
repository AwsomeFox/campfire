{
  "name": "@campfire/server",
  "version": "0.14.1",
  "private": true,
  "description": "Campfire API — NestJS, SQLite (Drizzle), OpenAPI",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "../../scripts/with-test-lock.sh sh -c 'nest build && NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest \"$@\"' --",
    "test:cov": "../../scripts/with-test-lock.sh sh test/run-test-cov.sh",
    "test:server:ci": "NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=/test/unit/ \\.perf\\.spec\\.ts$",
    "test:perf": "NODE_OPTIONS=--experimental-vm-modules jest --runTestsByPath test/search-fts.perf.spec.ts",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.jest.json --rootDir ../.."
  },
  "dependencies": {
    "@campfire/schema": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.5.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "yauzl": "^3.2.0",
    "nestjs-zod": "^4.2.0",
    "openid-client": "^6.8.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/archiver": "^6.0.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/yauzl": "^2.10.3",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.1",
    "express": "^5.2.1",
    "ical.js": "^2.2.1",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^29.7.0",
    "jose": "^6.2.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "v8-to-istanbul": "^9.3.0"
  }
}
