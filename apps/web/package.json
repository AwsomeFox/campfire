{
  "name": "@campfire/web",
  "version": "0.14.1",
  "private": true,
  "description": "Campfire web UI (placeholder until design lands)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/vite-build-strict.mjs",
    "preview": "vite preview",
    "test:css": "node scripts/vite-build-strict.mjs",
    "test:pwa": "node scripts/vite-build-strict.mjs && node scripts/check-pwa-dist.mjs",
    "test:pwa:dist": "node scripts/check-pwa-dist.mjs",
    "test:pwa:e2e": "playwright test e2e/tests/pwa-install-offline.spec.ts",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:component": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.first-run.config.ts && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "test:component:typecheck": "tsc --noEmit -p test/tsconfig.json",
    "e2e:install": "playwright install chromium",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run test:e2e:typecheck && npm run test:component:typecheck"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.101.3",
    "dompurify": "^3.2.3",
    "i18next": "^26.3.6",
    "marked": "^15.0.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
